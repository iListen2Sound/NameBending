<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Platforms>AnyCPU;x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<RumblePath>$(Rumble)</RumblePath>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="assets\fonts" />
		<None Remove="assets\namebending" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="assets\namebending" />
	</ItemGroup>

	<ItemGroup>
		<!-- Melonloader/il2cpp stuff -->
		<RumbleGameAssemblies Include="$(RumblePath)\MelonLoader\net6\**\*.dll" />
		<RumbleGameAssemblies Include="$(RumblePath)\MelonLoader\Il2CppAssemblies\**\*.dll" />

		<!-- Expand Wildcards -->
		<Reference Include="@(RumbleGameAssemblies)" Private="false" />

		<Reference Include="$(RumblePath)\Mods\OBS_Control_API.dll" />
		<Reference Include="$(RumblePath)\Mods\RumbleModdingAPI.dll" />
		<Reference Include="$(RumblePath)\Mods\UIFramework.dll" />
	</ItemGroup>

	<Target Name="PreBuild" AfterTargets="PreBuildEvent">
		<Exec Command="taskkill /f /t /im RUMBLE.exe 2&gt;NUL &amp;&amp; echo Killed rumble || echo Rumble was not running" IgnoreExitCode="true" />
	</Target>
	
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="copy &quot;$(TargetPath)&quot; &quot;$(RumblePath)\Mods\$(TargetFileName)&quot;" />
	</Target>

</Project>
